# Example environment for SyncSphere. DEVELOPMENT VALUES ONLY - no real secrets belong in this file.
#
# Docker Compose reads a file named ".env" automatically. To customise:
#     cp .env.example .env      (then edit .env; it is git-ignored)
# Without a .env file, docker-compose.yml falls back to exactly these defaults.

# ---- Used by docker-compose.yml ----
POSTGRES_DB=syncsphere
POSTGRES_USER=syncsphere
POSTGRES_PASSWORD=syncsphere_dev_password

# Host ports. Change them if something else on your machine already uses 8080/8081/5432/6379.
APP1_PORT=8080
APP2_PORT=8081
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Browser origins allowed to open the WebSocket (comma-separated patterns).
SYNCSPHERE_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- Read by the application itself (application.yml) ----
# Compose sets these for the containers. Set them in your shell only when running the app
# outside Docker, e.g. with ./mvnw spring-boot:run. Shown here with their built-in defaults.
#
# DB_URL=jdbc:postgresql://localhost:5432/syncsphere
# DB_USERNAME=syncsphere
# DB_PASSWORD=syncsphere_dev_password
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# SERVER_PORT=8080
# SYNCSPHERE_INSTANCE_ID=local-1234         (default: "local-" + a random number)
# SYNCSPHERE_REDIS_CHANNEL=syncsphere:sync-events
